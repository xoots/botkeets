{
  "name": "nanoclaw-lightweight",
  "version": "1.0.0",
  "description": "Lightweight NanoClaw - Claude API focus with minimal local models",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:app && npm run build:worker",
    "build:app": "tsc",
    "build:worker": "node scripts/build-worker-package.mjs",
    "mcp:start": "node dist/mcp-server.js",
    "doctor": "node --import tsx scripts/doctor.ts",
    "factory": "npm run factory:agents",
    "factory:agents": "tsx scripts/factory-agents.ts",
    "phasec:preflight": "tsx scripts/phasec-preflight.ts",
    "image:build": "./build.sh",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:harness": "tsx scripts/dev-harness.ts",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-doc-links.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:local": "pm2 start ecosystem.config.cjs --env local_only",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:local": "pm2 restart keet --env local_only",
    "pm2:cloud": "pm2 restart keet --env production",
    "pm2:logs": "pm2 logs --lines 100",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@trigger.dev/sdk": "^3.3.17",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.16.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "grammy": "^1.39.3",
    "js-tiktoken": "^1.0.21",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
